# Operation Mode
# Options: 'local' (default) or 'google-drive'
MODE=local

# OpenAI API Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration (Required for PDF processing)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive Configuration (Required for google-drive mode)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Discord Bot Configuration (Optional)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
ORGANIZE_FOLDER_PATH=/path/to/your/documents

# Documenso Integration (Optional)
DOCUMENSO_API_URL=https://api.documenso.com
DOCUMENSO_API_TOKEN=your_documenso_api_token_here
DOCUMENSO_APP_URL=https://app.documenso.com

# Anthropic API Configuration (Optional - for Claude Code enhanced search)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_CODE_MAX_ITERATIONS=10

# Server Configuration
PORT=3000

# Webhook Configuration (For Railway deployment)
WEBHOOK_URL=https://your-app.railway.app/webhook/google-drive